<Window x:Class="MFilesClone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MFiles Clone" Height="600" Width="900"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Cari:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

            <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="15,0,5,0" />
            <ComboBox Width="180" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategoryFilter}" VerticalAlignment="Center" />

            <Button Content="Refresh" Margin="15,0,0,0" Command="{Binding RefreshCommand}" />
            <Button Content="Hapus" Margin="5,0,0,0" Command="{Binding DeleteSelectedCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=DocumentsGrid}" />
            <Button Content="Check Out" Margin="15,0,0,0" Command="{Binding CheckOutSelectedCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=DocumentsGrid}" />
            <Button Content="Batal Check Out" Margin="5,0,0,0" Command="{Binding CancelCheckOutSelectedCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=DocumentsGrid}" />
            <Button Content="Check In..." Margin="5,0,0,0" Click="CheckIn_Click" />
            <Button Content="Export..." Margin="5,0,0,0" Click="Export_Click" />
            <Button Content="Riwayat Versi..." Margin="5,0,0,0" Click="VersionHistory_Click" />
            <Button Content="Preview" Margin="5,0,0,0" Click="Preview_Click" />
            <Button Content="Mount Drive M:" Margin="15,0,0,0" Click="MountDrive_Click" />
            <Button Content="Unmount Drive" Margin="5,0,0,0" Click="UnmountDrive_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Documents}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" Name="DocumentsGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Judul" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Category.Name}" Width="*" />
                    <DataGridTextColumn Header="Dibuat" Binding="{Binding CreatedAt}" Width="*" />
                    <DataGridTextColumn Header="Ukuran (bytes)" Binding="{Binding CurrentVersion.FileSizeBytes}" Width="*" />
                    <DataGridTextColumn Header="Versi" Binding="{Binding CurrentVersion.VersionNumber}" Width="60" />
                    <DataGridTextColumn Header="Dikunci Oleh" Binding="{Binding CheckedOutBy}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Belum ada dokumen. Drag &amp; drop file ke sini untuk menambahkan."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Documents.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Documents.Count, StringFormat='{}{0} dokumen'}" />
    </Grid>
</Window>
