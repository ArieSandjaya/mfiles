<Window x:Class="MFilesClone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MFiles Clone" Height="600" Width="900"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Cari:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />

            <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="15,0,5,0" />
            <ComboBox Width="180" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategoryFilter}" VerticalAlignment="Center" />

            <Button Content="Refresh" Margin="15,0,0,0" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Documents}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" Name="DocumentsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Judul" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category.Name}" Width="*" />
                <DataGridTextColumn Header="Dibuat" Binding="{Binding CreatedAt}" Width="*" />
                <DataGridTextColumn Header="Ukuran (bytes)" Binding="{Binding CurrentVersion.FileSizeBytes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Documents.Count, StringFormat='{}{0} dokumen'}" />
    </Grid>
</Window>
