<Window x:Class="MFilesClone.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Preview" Height="600" Width="800">
    <Grid>
        <wv2:WebView2 Name="WebViewControl" Visibility="Collapsed" />
        <Image Name="ImageControl" Stretch="Uniform" Visibility="Collapsed" />
        <TextBlock Name="UnsupportedText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Pratinjau tidak didukung untuk tipe file ini." Visibility="Collapsed" />
    </Grid>
</Window>
